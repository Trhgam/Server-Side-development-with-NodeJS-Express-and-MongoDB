<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Product Management - SDN302</title>
  <link
    href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
    rel="stylesheet"
  />
  <link rel="stylesheet" href="/stylesheets/products.css" />
</head>
<body>
  <nav class="navbar navbar-expand-lg navbar-dark navbar-custom shadow-sm sticky-top">
    <div class="container-fluid px-4">
      <a class="navbar-brand fw-bold" href="/admin/products">
        Product Management
      </a>
      <div class="d-flex align-items-center">
        <% if (manager) { %>
          <span class="text-light">
            Manager: <strong><%= manager.code %></strong>
          </span>
        <% } %>
      </div>
    </div>
  </nav>

  <main class="container-fluid px-4 py-4">
    <% if (message) { %>
      <div class="alert alert-success alert-dismissible fade show mb-4" role="alert">
        <div><%= message %></div>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
      </div>
    <% } %>

    <% if (error && !showAddModal) { %>
      <div class="alert alert-danger alert-dismissible fade show mb-4" role="alert">
        <div><%= error %></div>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
      </div>
    <% } %>

    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
      <div>
        <h2 class="fw-bold mb-1">Product List</h2>
        <p class="text-muted mb-0">Manage and display system product details</p>
      </div>
      <div>
        <button
          type="button"
          class="btn btn-primary"
          data-bs-toggle="modal"
          data-bs-target="#addProductModal"
        >
          Add New Product
        </button>
      </div>
    </div>

    <% if (!products || products.length === 0) { %>
      <div class="card p-5 text-center shadow-sm">
        <h4 class="text-secondary">No products found in the database</h4>
        <p class="text-muted">Click the "Add New Product" button above to create a new product.</p>
      </div>
    <% } else { %>
      <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 row-cols-xl-4 g-4">
        <% products.forEach(product => { %>
          <div class="col">
            <div class="card product-card h-100 shadow-sm">
              <div class="card-body d-flex flex-column">
                <div class="d-flex justify-content-between align-items-start mb-2">
                  <h5 class="card-title fw-bold mb-0 text-truncate" title="<%= product.name %>">
                    <%= product.name %>
                  </h5>
                  <% if (product.isActive) { %>
                    <span class="badge bg-success">Active</span>
                  <% } else { %>
                    <span class="badge bg-secondary">Inactive</span>
                  <% } %>
                </div>

                <div class="mb-2">
                  <span class="badge bg-primary-subtle text-primary border border-primary-subtle">
                    <%= product.category %>
                  </span>
                </div>

                <div class="my-2">
                  <div class="price-text mb-1">$<%= product.price %></div>
                  <div class="text-secondary small mb-1">
                    Stock: <strong><%= product.stock %></strong>
                  </div>
                  <div class="text-secondary small">
                    Supplier: 
                    <strong><%= product.supplier ? product.supplier.name : 'N/A' %></strong>
                  </div>
                </div>

                <div class="mt-2 mb-3 flex-grow-1">
                  <% if (product.tags && product.tags.length > 0) { %>
                    <% product.tags.forEach(tag => { %>
                      <span class="badge tag-badge me-1 mb-1">#<%= tag %></span>
                    <% }) %>
                  <% } else { %>
                    <span class="text-muted small fst-italic">No tags</span>
                  <% } %>
                </div>

                <div class="border-top pt-3 mt-auto d-flex justify-content-between gap-2">
                  <a href="/admin/products/<%= product._id %>" class="btn btn-warning btn-sm flex-fill">
                    Edit
                  </a>

                  <form
                    action="/admin/products/delete/<%= product._id %>"
                    method="POST"
                    class="flex-fill"
                    onsubmit="return confirm('Are you sure you want to delete this product?');"
                  >
                    <button type="submit" class="btn btn-danger btn-sm w-100">
                      Delete
                    </button>
                  </form>
                </div>
              </div>
            </div>
          </div>
        <% }) %>
      </div>
    <% } %>
  </main>

  <div
    class="modal fade"
    id="addProductModal"
    tabindex="-1"
    aria-labelledby="addProductModalLabel"
    aria-hidden="true"
  >
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content">
        <div class="modal-header bg-primary text-white">
          <h5 class="modal-title fw-bold" id="addProductModalLabel">
            Add New Product
          </h5>
          <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>

        <form action="/admin/products/create" method="POST">
          <div class="modal-body">
            <% if (error && showAddModal) { %>
              <div class="alert alert-danger mb-3" role="alert">
                <div><%= error %></div>
              </div>
            <% } %>

            <div class="mb-3">
              <label for="name" class="form-label fw-semibold">Product Name <span class="text-danger">*</span></label>
              <input
                type="text"
                class="form-control"
                id="name"
                name="name"
                placeholder="Enter product name"
                value="<%= formData && formData.name ? formData.name : '' %>"
                required
              />
            </div>

            <div class="mb-3">
              <label for="category" class="form-label fw-semibold">Category <span class="text-danger">*</span></label>
              <input
                type="text"
                class="form-control"
                id="category"
                name="category"
                placeholder="Enter category (e.g. Laptop, Accessory)"
                value="<%= formData && formData.category ? formData.category : '' %>"
                required
              />
            </div>

            <div class="row">
              <div class="col-md-6 mb-3">
                <label for="price" class="form-label fw-semibold">Price ($) <span class="text-danger">*</span></label>
                <input
                  type="number"
                  step="any"
                  class="form-control"
                  id="price"
                  name="price"
                  placeholder="0.00"
                  value="<%= formData && formData.price ? formData.price : '' %>"
                  required
                />
              </div>

              <div class="col-md-6 mb-3">
                <label for="stock" class="form-label fw-semibold">Stock <span class="text-danger">*</span></label>
                <input
                  type="number"
                  class="form-control"
                  id="stock"
                  name="stock"
                  placeholder="0"
                  value="<%= formData && formData.stock ? formData.stock : '0' %>"
                  required
                />
              </div>
            </div>

            <div class="mb-3">
              <label for="supplier" class="form-label fw-semibold">Supplier <span class="text-danger">*</span></label>
              <select class="form-select" id="supplier" name="supplier" required>
                <option value="">-- Select a Supplier --</option>
                <% if (suppliers && suppliers.length > 0) { %>
                  <% suppliers.forEach(sup => { %>
                    <option
                      value="<%= sup._id %>"
                      <%= formData && formData.supplier === sup._id.toString() ? 'selected' : '' %>
                    >
                      <%= sup.name %>
                    </option>
                  <% }) %>
                <% } %>
              </select>
            </div>

            <div class="mb-3">
              <label for="tags" class="form-label fw-semibold">Tags</label>
              <input
                type="text"
                class="form-control"
                id="tags"
                name="tags"
                placeholder="e.g. apple, laptop, portable"
                value="<%= formData && formData.tags ? formData.tags : '' %>"
              />
              <div class="form-text">Enter comma-separated tags (e.g. a,b,c).</div>
            </div>

            <div class="mb-3">
              <label for="isActive" class="form-label fw-semibold">Active Status</label>
              <select class="form-select" id="isActive" name="isActive">
                <option value="true" <%= !formData || formData.isActive !== 'false' ? 'selected' : '' %>>Active</option>
                <option value="false" <%= formData && formData.isActive === 'false' ? 'selected' : '' %>>Inactive</option>
              </select>
            </div>
          </div>

          <div class="modal-footer">
            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            <button type="submit" class="btn btn-primary">
              Add Product
            </button>
          </div>
        </form>
      </div>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

  <% if (showAddModal) { %>
    <script>
      const modalEl = document.getElementById('addProductModal');
      if (modalEl) {
        const modal = new bootstrap.Modal(modalEl);
        modal.show();
      }
    </script>
  <% } %>
</body>
</html>