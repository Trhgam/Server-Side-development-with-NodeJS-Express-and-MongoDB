<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Edit Product - SDN302</title>
  <link
    href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
    rel="stylesheet"
  />
  <link rel="stylesheet" href="/stylesheets/editProduct.css" />
</head>
<body>
  <nav class="navbar navbar-expand-lg navbar-dark navbar-custom shadow-sm sticky-top">
    <div class="container-fluid px-4">
      <a class="navbar-brand fw-bold" href="/admin/products">
        Product Management
      </a>
      <div class="d-flex align-items-center">
        <% if (manager) { %>
          <span class="text-light">
            Manager: <strong><%= manager.code %></strong>
          </span>
        <% } %>
      </div>
    </div>
  </nav>

  <main class="container py-4" style="max-width: 720px;">
    <div class="mb-3">
      <a href="/admin/products" class="btn btn-outline-secondary btn-sm">
        Back to Product List
      </a>
    </div>

    <% if (error) { %>
      <div class="alert alert-danger alert-dismissible fade show mb-4" role="alert">
        <div><%= error %></div>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
      </div>
    <% } %>

    <div class="card edit-card p-4">
      <div class="d-flex justify-content-between align-items-center border-bottom pb-3 mb-4">
        <div>
          <h3 class="fw-bold mb-1">Edit Product</h3>
          <p class="text-muted small mb-0">ID: <code><%= product._id %></code></p>
        </div>
        <span class="badge <%= product.isActive ? 'bg-success' : 'bg-secondary' %> fs-6">
          <%= product.isActive ? 'Active' : 'Inactive' %>
        </span>
      </div>

      <form action="/admin/products/<%= product._id %>" method="POST">
        <div class="mb-3">
          <label for="name" class="form-label fw-semibold">Product Name <span class="text-danger">*</span></label>
          <input
            type="text"
            class="form-control"
            id="name"
            name="name"
            value="<%= product.name %>"
            required
          />
        </div>

        <div class="mb-3">
          <label for="category" class="form-label fw-semibold">Category <span class="text-danger">*</span></label>
          <input
            type="text"
            class="form-control"
            id="category"
            name="category"
            value="<%= product.category %>"
            required
          />
        </div>

        <div class="row">
          <div class="col-md-6 mb-3">
            <label for="price" class="form-label fw-semibold">Price ($) <span class="text-danger">*</span></label>
            <input
              type="number"
              step="any"
              class="form-control"
              id="price"
              name="price"
              value="<%= product.price %>"
              required
            />
          </div>

          <div class="col-md-6 mb-3">
            <label for="stock" class="form-label fw-semibold">Stock <span class="text-danger">*</span></label>
            <input
              type="number"
              class="form-control"
              id="stock"
              name="stock"
              value="<%= product.stock %>"
              required
            />
          </div>
        </div>

        <div class="mb-3">
          <label for="supplier" class="form-label fw-semibold">Supplier <span class="text-danger">*</span></label>
          <select class="form-select" id="supplier" name="supplier" required>
            <option value="">-- Select Supplier --</option>
            <% if (suppliers && suppliers.length > 0) { %>
              <% suppliers.forEach(sup => { %>
                <% 
                  const currentSupId = product.supplier ? (product.supplier._id ? product.supplier._id.toString() : product.supplier.toString()) : '';
                  const isSelected = currentSupId === sup._id.toString();
                %>
                <option value="<%= sup._id %>" <%= isSelected ? 'selected' : '' %>>
                  <%= sup.name %>
                </option>
              <% }) %>
            <% } %>
          </select>
        </div>

        <div class="mb-3">
          <label for="tags" class="form-label fw-semibold">Tags</label>
          <% 
            const tagsString = (product.tags && Array.isArray(product.tags)) ? product.tags.join(',') : (product.tags || '');
          %>
          <input
            type="text"
            class="form-control"
            id="tags"
            name="tags"
            value="<%= tagsString %>"
            placeholder="a,b,c"
          />
          <div class="form-text">Comma-separated tags (e.g. vegan,organic,healthy).</div>
        </div>

        <div class="mb-4">
          <label for="isActive" class="form-label fw-semibold">Active Status</label>
          <select class="form-select" id="isActive" name="isActive">
            <option value="true" <%= product.isActive ? 'selected' : '' %>>Active</option>
            <option value="false" <%= !product.isActive ? 'selected' : '' %>>Inactive</option>
          </select>
        </div>

        <div class="d-flex justify-content-end gap-2 border-top pt-3">
          <a href="/admin/products" class="btn btn-secondary">Cancel</a>
          <button type="submit" class="btn btn-primary">
            Save Changes
          </button>
        </div>
      </form>
    </div>
  </main>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
