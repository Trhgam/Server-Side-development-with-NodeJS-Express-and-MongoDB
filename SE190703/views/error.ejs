<!DOCTYPE html>
<html>
<head>
  <title>Error</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
</head>
<body class="p-5">
  <div class="container">
    <h1 class="text-danger"><%= message %></h1>
    <% if (error && error.status) { %>
      <h2>Status: <%= error.status %></h2>
    <% } %>
    <% if (error && error.stack) { %>
      <pre class="bg-light p-3 border rounded"><%= error.stack %></pre>
    <% } %>
    <a href="/auth/view" class="btn btn-primary mt-3">Back to Login</a>
  </div>
</body>
</html>
