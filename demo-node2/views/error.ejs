<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title>Error</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet">
  </head>
  <body class="p-5 bg-light">
    <div class="container bg-white p-4 rounded shadow-sm">
      <h1 class="text-danger"><%= message %></h1>
      <h2 class="text-muted"><%= error.status || 500 %></h2>
      <pre class="bg-dark text-white p-3 rounded mt-3"><%= error.stack %></pre>
      <a href="/products" class="btn btn-primary mt-3">Quay lại trang Products</a>
    </div>
  </body>
</html>
