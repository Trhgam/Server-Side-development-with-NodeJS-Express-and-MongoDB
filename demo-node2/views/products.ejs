<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Student Dashboard</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
    <link rel="stylesheet" href="/stylesheets/products.css"/>
  </head>

  <body>
    <header>
      <h1>Student Dashboard</h1>

      <nav>
        <a href="#">Home</a>
        <a href="#">Subjects</a>
        <a href="#">Profile</a>
      </nav>
    </header>

    <main class="container">
      <section class="welcome-card">
        <h1 >Products</h1>
              <!-- Button trigger modal -->
          <button type="button" class="btn btn-primary mb-4" data-bs-toggle="modal" data-bs-target="#exampleModal">
            Launch demo modal
          </button>
        <!-- Đi thi nhớ có Modal thì khi bấm nút hiện modal chẳng hạn -->
        <!-- các lệnh lập trình phải nằm trong dấu <%%> -->
          <% if (!products.length) { %>

            <h1>Data not found</h1>

            <% } else { %>

              <div class="subject-list">

                <% products.forEach((product) => { %>

                  <div class="subject-card">

                    <!-- Hiển thị product -->
                    <%- include("tittle", { product: product }) %>

                    <!-- Nút mở Modal Edit -->
                    <div class="mt-3">
                      <button 
                        type="button" 
                        class="btn btn-warning btn-sm" 
                        data-bs-toggle="modal" 
                        data-bs-target="#editModal-<%= product._id %>">
                        Edit
                      </button>
                    </div>

                  </div>

                <% }) %>

              </div>

            <% } %>
      </section>
    </main>

    <!-- ==================== TOÀN BỘ MODALS ĐẶT Ở NGOÀI CÙNG (DƯỚI MAIN) ==================== -->
    <% if (products && products.length) { %>
      <% products.forEach((product) => { %>
        <div class="modal" id="editModal-<%= product._id %>" tabindex="-1" aria-labelledby="editModalLabel-<%= product._id %>" aria-hidden="true">
          <div class="modal-dialog">
            <div class="modal-content">
              <div class="modal-header">
                <h1 class="modal-title fs-5" id="editModalLabel-<%= product._id %>">Edit Product</h1>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
              </div>
              <form method="post" action="/products/edit/<%= product._id %>">
                <div class="modal-body">
                  <label class="form-label text-start d-block">Tên sản phẩm:</label>
                  <input 
                    type="text" 
                    name="title" 
                    class="form-control" 
                    value="<%= product.title %>" 
                    required 
                  />
                </div>
                <div class="modal-footer">
                  <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                  <button type="submit" class="btn btn-primary">Save changes</button>
                </div>
              </form>
            </div>
          </div>
        </div>
      <% }) %>
    <% } %>

    <!-- Modal Create -->
    <div class="modal" id="exampleModal" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
      <div class="modal-dialog">
        <div class="modal-content">
          <div class="modal-header">
            <h1 class="modal-title fs-5" id="exampleModalLabel">Create Product</h1>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
          </div>
          <form method="post" action="/products">
            <div class="modal-body">
              <label class="form-label text-start d-block">Tên sản phẩm:</label>
              <input name="title" class="form-control" placeholder="Nhập tên sản phẩm..." required />
            </div>
            <div class="modal-footer">
              <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
              <button type="submit" class="btn btn-primary">Submit</button> 
            </div>
          </form>
        </div>
      </div>
    </div>
    <!-- Lab 2 tương tự get lên phải render nhưu vậy , bấm hiện thị modal và pahir có form để add -->
    <!-- có edit và delete -->

    <footer>© 2026 Student Dashboard</footer>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI" crossorigin="anonymous"></script>
  </body>
</html>
